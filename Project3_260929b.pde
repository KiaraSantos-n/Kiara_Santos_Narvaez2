size(500,500);
background(255);

textAlign(CENTER, CENTER);

PFont arialBlackFont = loadFont("Arial-Black-48.vlw");
textFont(arialBlackFont);

fill(100,100,255); // Blue
translate(width / 2, height / 2);
text("A", 0,0);

text("A", 20,20);
scale(2);



text("A", 100, 100); //straight A's
text("A", 100,200); //straight A's
text("A", 100, 300); //straight A's
text("A", 100, 400); //striaght A's


text("A", 400, 100); //straight A's
