// Descritption: This is about the Letter C. 

size(500, 500);
background(255);

textAlign(CENTER, CENTER);

PFont arialNarrow = loadFont("ArialNarrow-BoldItalic-48.vlw");
textFont(arialNarrow);

fill(255, 0, 255); // purple
translate(width / 8, height / 8);
text("c", 0, 0);

translate(120, 100); // The First C of the begiining
rotate(TAU*0.200);
text("c", 0, 0);
resetMatrix();

text("c", 120, 100);
translate(200, 100);
rotate(TAU*0.13);
text("c", 0, 0);
resetMatrix();


text("c", 200, 100); // The second C of the beginning



text("c", 220, 100); // The third C of the beginning
translate(220, 100);
rotate(TAU*0.180);
text("c", 0, 0);
resetMatrix();


text("c", 280, 100); // The Forth C of the begiinning
text("c", 310, 100);

text("c", 120, 130); // The First C under the the top of the first C
translate(120,130);
rotate(TAU*0.300);
text("c", 0, 0);
resetMatrix();


text("c", 200, 130);  // The Second C under the top of the second C
text("c", 220, 130); //  The Third C under the top of the Third C
text("c", 280, 130); // The Forth C under the top of the Forth C
text("c", 310, 130); // The fifth C

text("c", 200, 160); // The first C under the Second C in the second place
text("c", 220, 160); // The second C under the third C of the second place
text("c", 280, 160); // The third C under the second C
translate(280, 180); 
rotate(TAU*0.180);
text("c", 0, 0);
resetMatrix();


text("c", 300, 160); 
text("c", 180, 210);
text("c", 210, 210);
text("c", 260, 210);
text("c", 300, 210);
translate(300, 210);
rotate(TAU*0.300);
text("c", 0, 0);
resetMatrix();

text("c", 160, 280);


text("c", 200, 280);
text("c", 220, 280);
translate(220, 280);
rotate(TAU*0.300);
text("c", 0, 0);
resetMatrix();

text("c", 260, 280);

text("c", 300, 280);
translate(300, 280);
rotate(TAU*0.300);
text("c", 0, 0);
resetMatrix();

text("c", 320, 360);
